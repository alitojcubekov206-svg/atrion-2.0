+/** Seconds over which part start times are spread, bottom to top. */
+const ASSEMBLE_SPREAD = 1.6;
+/** Seconds one part takes to drop into place. */
+const ASSEMBLE_PART_SECONDS = 0.7;
+/** Stagger between the repeated copies of one part (rows, columns), and the
+ * most it may add in total so a long row still lands inside the window. */
+const ASSEMBLE_INSTANCE_STEP = 0.025;
+const ASSEMBLE_INSTANCE_SPREAD = 0.4;
+
+function easeOutCubic(t: number) {
+  return 1 - Math.pow(1 - t, 3);
+}
+
+/** Overshoots a little and settles — a part "clicking" into place. */
+function easeOutBack(t: number) {
+  const c1 = 1.4;
+  const c3 = c1 + 1;
+  return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
+}
+
+function prefersReducedMotion() {
+  return typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+}
+
 function snapValue(n: number, step: number) {
