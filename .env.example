# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# PostgreSQL connection string (on Vercel this is set automatically by Neon Postgres storage)
DATABASE_URL="postgresql://user:password@host/dbname"
# Direct (non-pooled) connection, used only to run Prisma Migrate (see docs/DEVELOPMENT.md).
# Same string without "-pooler" in the host name. The app itself never reads it.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname"

# Secret for signing auth tokens (JWT). Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Google Identity Services: включать после настройки web Client ID и add-google-auth.sql.
# Публичный Client ID; client secret для этого способа не требуется.
GOOGLE_CLIENT_ID=""
GOOGLE_AUTH_ENABLED="false"

# Текстовый AI: auto использует существующий текстовый ключ, затем Cloudflare.
# cloudflare выбирает Workers AI; compatible использует прежний API; disabled отключает AI.
AI_TEXT_PROVIDER="auto"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_TEXT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# Интерьеры: local работает без внешнего AI; cloudflare включает только Workers AI.
# Платный compatible-провайдер в новом модуле автоматически не выбирается.
DESIGN_TEXT_PROVIDER="local"
# Анализ планов включать после принятия лицензии Meta владельцем Cloudflare-аккаунта.
DESIGN_VISION_ENABLED="false"
DESIGN_R2_BUCKET=""
DESIGN_R2_ACCESS_KEY_ID=""
DESIGN_R2_SECRET_ACCESS_KEY=""
OPENAI_API_KEY=""

# Optional: OpenAI-compatible provider endpoint (e.g. Groq: https://api.groq.com/openai/v1)
OPENAI_BASE_URL=""

# Primary model (for Groq use e.g. openai/gpt-oss-120b; llama-3.3-70b-versatile was retired by Groq on 2026-08-16)
OPENAI_MODEL="gpt-4o"

# Optional Atrion AI fallback. Recommended: Gemini from Google AI Studio.
# Резерв применяется только к compatible primary. Cloudflare на него не переключается.
AI_FALLBACK_API_KEY=""
AI_FALLBACK_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_FALLBACK_MODEL="gemini-3.8-flash"

# Email verification via https://brevo.com (free tier: 300 emails/day, no domain needed —
# just verify one sender email address by clicking the link Brevo emails you).
# 1. Sign up free at brevo.com
# 2. Settings -> Senders & IP -> Senders -> add and verify an email you own (e.g. a Gmail)
# 3. Settings -> SMTP & API -> API Keys -> create a key -> BREVO_API_KEY
# Keep EMAIL_VERIFICATION_ENABLED "false" until you've confirmed a real code arrives.
EMAIL_VERIFICATION_ENABLED="false"
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Atrion"
# Только при NODE_ENV=development: вернуть OTP в ответе при сбое доставки. В production флаг игнорируется.
EMAIL_DEV_RETURN_CODE="false"

# Вход для жюри и демо: GET /api/auth/demo создаёт отдельный гостевой аккаунт на каждый визит,
# входит в него и открывает 3D-студию. Выключено по умолчанию; включать только на время показа.
DEMO_LOGIN_ENABLED="false"

# Public application URL (metadata, sitemap, absolute links)
APP_URL="https://atrion-2-0.vercel.app"

# Optional contact number for the legal page (digits only; not used for payments)
PAYMENT_WHATSAPP="996700123456"
